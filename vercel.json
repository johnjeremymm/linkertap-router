
{
  "redirects": [
    {
      "source": "/@john",
      "destination": "/@john/",
      "permanent": false
    }
  ],
  "rewrites": [
    {
      "source": "/@john/",
      "destination": "https://john-sandy.vercel.app/"
    },
    {
      "source": "/@john/:path*",
      "destination": "https://john-sandy.vercel.app/:path*"
    }
  ]
}
